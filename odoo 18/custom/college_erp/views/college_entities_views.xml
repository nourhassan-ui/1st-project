<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Faculty views -->
    <record id="view_college_faculty_tree" model="ir.ui.view">
        <field name="name">college.faculty.list</field>
        <field name="model">college_erp.faculty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_college_faculty_form" model="ir.ui.view">
        <field name="name">college.faculty.form</field>
        <field name="model">college_erp.faculty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="course_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_faculty" model="ir.actions.act_window">
        <field name="name">Faculty</field>
        <field name="res_model">college_erp.faculty</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Course views -->
    <record id="view_college_course_tree" model="ir.ui.view">
        <field name="name">college.course.list</field>
        <field name="model">college_erp.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="faculty_id"/>
            </list>
        </field>
    </record>

    <record id="view_college_course_form" model="ir.ui.view">
        <field name="name">college.course.form</field>
        <field name="model">college_erp.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="faculty_id"/>
                        <field name="student_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">college_erp.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Student views -->
    <record id="view_college_student_tree" model="ir.ui.view">
        <field name="name">college.student.list</field>
        <field name="model">college_erp.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_college_student_form" model="ir.ui.view">
        <field name="name">college.student.form</field>
        <field name="model">college_erp.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="dob"/>
                        <field name="course_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">college_erp.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_college_erp_management" name="Management" parent="menu_college_erp_root"/>
    <menuitem id="menu_college_faculty" name="Faculty" parent="menu_college_erp_management" action="action_college_faculty"/>
    <menuitem id="menu_college_course" name="Courses" parent="menu_college_erp_management" action="action_college_course"/>
    <menuitem id="menu_college_student" name="Students" parent="menu_college_erp_management" action="action_college_student"/>

</odoo>
