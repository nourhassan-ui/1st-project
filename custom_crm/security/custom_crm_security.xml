<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="custom_crm_category">
            <field name="name">Sales Extra Rights</field>
        </record>

        <record id="group_can_control_committed_opportunities" model="res.groups">
            <field name="name">Can Control Committed</field>
            <field name="category_id" ref="custom_crm.custom_crm_category"/>
        </record>

        <record id="group_can_restore_opportunities" model="res.groups">
            <field name="name">Can Restore Opportunity</field>
            <field name="category_id" ref="custom_crm.custom_crm_category"/>
        </record>

        <record id="group_can_edit_offering_opportunities" model="res.groups">
            <field name="name">Can Edit Offering Opportunity</field>
            <field name="category_id" ref="custom_crm.custom_crm_category"/>
        </record>

        <record id="model_crm_lead_rule_portal" model="ir.rule">
            <field name="name">CRM Lead: portal user</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
